# Template: copy to agent-gateway/alerts.env (the systemd units read it).
# Without these variables events simply accumulate in the queue (nothing is lost).

# Telegram alerts (bot via @BotFather, chat_id via getUpdates)
DYDX_TG_BOT_TOKEN=
DYDX_TG_CHAT_ID=

# Webhook recipients (comma-separated) — see examples/webhook-receiver.py
DYDX_WEBHOOKS=
