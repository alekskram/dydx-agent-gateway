# Шаблон: скопировать в agent-gateway/alerts.env (systemd юниты его читают).
# Без этих переменных события просто копятся в очереди (ничего не теряется).

# Telegram-алерты (бот через @BotFather, chat_id через getUpdates)
DYDX_TG_BOT_TOKEN=
DYDX_TG_CHAT_ID=

# Вебхуки получателей (через запятую) — см. examples/webhook-receiver.py
DYDX_WEBHOOKS=
